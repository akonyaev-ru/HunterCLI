# Поведение по умолчанию, если Git не может сам определить тип файла
* text=auto

# Исходники и документация: проект собирается и запускается на Windows
*.py    text eol=crlf
*.md    text eol=crlf
*.txt   text eol=crlf
*.json  text eol=crlf
*.spec  text eol=crlf
*.bat   text eol=crlf

# Сценарии GitHub Actions выполняются на раннерах Linux — только LF
*.yml   text eol=lf
*.yaml  text eol=lf

# Бинарники не трогать
*.png   binary
*.ico   binary
*.exe   binary

# На GitHub считаем языком проекта Python, а не «изображения»
*.svg    linguist-documentation
tests/*  linguist-documentation
